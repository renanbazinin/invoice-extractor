{
  "name": "invoice-extractor",
  "private": true,
  "version": "0.1.0",
  "description": "Generic, template-free invoice extraction: read, structure, interpret, validate. No LLM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanbazinin/invoice-extractor.git"
  },
  "homepage": "https://github.com/renanbazinin/invoice-extractor#readme",
  "keywords": [
    "invoice",
    "extraction",
    "ocr",
    "hebrew",
    "pdf",
    "no-llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "invoice-extractor": "./src/cli.ts"
  },
  "scripts": {
    "extract": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus": "tsx eval/generate.ts",
    "eval": "tsx eval/run.ts",
    "web:vendor": "node web/scripts/copy-vendor.mjs",
    "web:dev": "npm run web:vendor && vite --config web/vite.config.ts",
    "web:build": "npm run web:vendor && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/heb": "^1.0.0",
    "bidi-js": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
